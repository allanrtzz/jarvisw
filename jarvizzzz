    description:"Obtém a data e hora local atual do navegador.",
    input_schema:{
      type:"object",
      properties:{},
      required:[]
    },
    execute:async()=>{
      const d=new Date();
      return {
        iso:d.toISOString(),
        local:d.toLocaleString("pt-BR"),
        timezone:Intl.DateTimeFormat().resolvedOptions().timeZone
      };
    }
  },

  calculator:{
    description:"Calcula expressões matemáticas simples. Não use para executar código.",
    input_schema:{
      type:"object",
      properties:{
        expression:{type:"string",description:"Expressão matemática, por exemplo 12*8+5"}
      },
      required:["expression"]
    },
    execute:async({expression})=>{
      if(!/^[0-9+\-*/().,%\s^]+$/.test(expression)){
        throw new Error("Expressão matemática não permitida.");
      }

      const safe=expression.replace(/\^/g,"**").replace(/%/g,"/100");
      const result=Function(`"use strict"; return (${safe})`)();

      if(!Number.isFinite(result)) throw new Error("Resultado inválido.");
      return {expression,result};
    }
  },

