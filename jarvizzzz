function saveSettings(){
  settings.apiKey=els.apiKey.value.trim();
  settings.model=els.model.value;
  settings.wakeWord=els.wakeWord.value.trim().toLocaleLowerCase("pt-BR") || "jarvis";
  settings.wakeEnabled=els.wakeEnabled.checked;
  settings.voiceURI=els.voiceSelect.value;
  settings.pitch=Number(els.pitch.value);
  settings.rate=Number(els.rate.value);
  settings.userName=els.userName.value.trim();
  settings.customPersonality=els.customPersonality.value.trim();

  if(settings.userName){
    memory.name=settings.userName;
    save(STORAGE.memory,memory);
  }

  save(STORAGE.settings,settings);

  els.apiStatus.textContent=settings.apiKey
    ? `IA: ${settings.model}`
    : "IA: não configurada";

  toast("Configurações salvas.");
  els.settingsDialog.close();
}

