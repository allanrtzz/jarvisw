<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#05080d">
<title>J.A.R.V.I.S. — Assistente Pessoal</title>

<style>
:root{
  --bg:#05080d;
  --bg2:#09111b;
  --panel:rgba(8,16,27,.82);
  --panel2:rgba(13,25,40,.76);
  --line:rgba(92,190,255,.18);
  --accent:#4dc9ff;
  --accent2:#9ee9ff;
  --text:#eaf8ff;
  --muted:#7891a5;
  --danger:#ff5e70;
  --ok:#62f0ad;
  --shadow:0 0 40px rgba(0,160,255,.12);
}

[data-theme="light"]{
  --bg:#eaf3f8;
  --bg2:#dceaf2;
  --panel:rgba(255,255,255,.82);
  --panel2:rgba(245,251,255,.88);
  --line:rgba(20,110,160,.2);
  --accent:#087db3;
  --accent2:#075f88;
  --text:#10202b;
  --muted:#557080;
  --shadow:0 0 40px rgba(0,100,150,.12);
}

*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
body{overflow:hidden}
button,input,textarea,select{font:inherit}
button{cursor:pointer}

.app{
  width:100%;
  height:100dvh;
  display:grid;
  grid-template-rows:auto 1fr auto;
  background:
    radial-gradient(circle at 50% 45%,rgba(20,150,220,.08),transparent 35%),
    linear-gradient(135deg,var(--bg),var(--bg2));
  position:relative;
  overflow:hidden;
}

.app:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  opacity:.16;
  background-image:
    linear-gradient(var(--line) 1px,transparent 1px),
    linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:48px 48px;
  mask-image:linear-gradient(to bottom,transparent,#000 25%,#000 75%,transparent);
}

.topbar{
  position:relative;
  z-index:5;
  min-height:64px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:calc(10px + env(safe-area-inset-top)) 18px 10px;
  border-bottom:1px solid var(--line);
  background:rgba(3,8,14,.5);
  backdrop-filter:blur(18px);
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  min-width:0;
}

.logo{
  width:38px;height:38px;border:1px solid var(--accent);
  border-radius:50%;display:grid;place-items:center;
  color:var(--accent);font-size:12px;font-weight:800;
  box-shadow:0 0 18px rgba(77,201,255,.3);
}

.brand strong{letter-spacing:.18em;font-size:13px}
.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.12em;margin-top:2px}

.clock{text-align:right;font-variant-numeric:tabular-nums}
.clock strong{display:block;font-size:18px;letter-spacing:.08em}
.clock small{color:var(--muted);font-size:10px}

.workspace{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:minmax(220px,300px) minmax(300px,1fr) minmax(220px,300px);
  min-height:0;
  gap:14px;
  padding:14px;
}

.side{
  min-height:0;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.panel{
  min-height:0;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:var(--shadow);
  backdrop-filter:blur(18px);
  overflow:hidden;
}

.panel-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:13px 14px;
  border-bottom:1px solid var(--line);
}

.panel-head span{
  font-size:10px;
  letter-spacing:.16em;
  color:var(--muted);
  text-transform:uppercase;
}

.panel-body{
  padding:12px;
  overflow:auto;
}

.list{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.item{
  border:1px solid var(--line);
  background:var(--panel2);
  border-radius:12px;
  padding:10px;
}

.item strong{font-size:12px}
.item small{display:block;color:var(--muted);font-size:10px;margin-top:4px}

.center{
  min-width:0;
  min-height:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  position:relative;
}

.status{
  position:absolute;
  top:5%;
  text-align:center;
  z-index:3;
}

.status-label{
  font-size:11px;
  letter-spacing:.22em;
  color:var(--accent2);
  text-transform:uppercase;
}

.status-detail{
  color:var(--muted);
  font-size:10px;
  margin-top:5px;
}

.orb-wrap{
  width:min(58vh,480px,72vw);
  aspect-ratio:1;
  position:relative;
}

#orb{
  width:100%;height:100%;
  display:block;
}

.orb-ring{
  position:absolute;
  inset:10%;
  border:1px solid var(--line);
  border-radius:50%;
  animation:spin 18s linear infinite;
  pointer-events:none;
}

.orb-ring:before,.orb-ring:after{
  content:"";
  position:absolute;
  inset:-8%;
  border:1px dashed rgba(77,201,255,.14);
  border-radius:50%;
}

.orb-ring:after{
  inset:18%;
  border-style:solid;
  border-color:rgba(77,201,255,.1);
  animation:spin 11s linear reverse infinite;
}

@keyframes spin{to{transform:rotate(360deg)}}

.mic-button{
  position:absolute;
  left:50%;
  bottom:7%;
  transform:translateX(-50%);
  width:74px;height:74px;border-radius:50%;
  border:1px solid var(--accent);
  background:rgba(3,15,24,.82);
  color:var(--accent);
  box-shadow:0 0 30px rgba(77,201,255,.22);
  font-size:26px;
  z-index:5;
}

.mic-button.active{
  animation:pulse 1.1s infinite;
}

@keyframes pulse{
  50%{box-shadow:0 0 55px rgba(77,201,255,.55);transform:translateX(-50%) scale(1.05)}
}

.conversation{
  position:absolute;
  left:3%;
  right:3%;
  bottom:2%;
  max-height:29%;
  overflow:auto;
  display:flex;
  flex-direction:column;
  gap:7px;
  padding:5px;
  mask-image:linear-gradient(to bottom,transparent,#000 10%);
}

.msg{
  max-width:82%;
  padding:9px 12px;
  border:1px solid var(--line);
  border-radius:13px;
  font-size:12px;
  line-height:1.4;
  white-space:pre-wrap;
}

.msg.user{
  align-self:flex-end;
  background:rgba(77,201,255,.09);
}

.msg.assistant{
  align-self:flex-start;
  background:var(--panel);
}

.msg .role{
  font-size:9px;
  color:var(--muted);
  letter-spacing:.12em;
  text-transform:uppercase;
  margin-bottom:4px;
}

.composer{
  position:relative;
  z-index:5;
  display:flex;
  align-items:center;
  gap:8px;
  padding:10px 14px calc(10px + env(safe-area-inset-bottom));
  border-top:1px solid var(--line);
  background:rgba(3,8,14,.65);
  backdrop-filter:blur(18px);
}

.composer input{
  flex:1;
  min-width:0;
  height:46px;
  border:1px solid var(--line);
  border-radius:13px;
  background:var(--panel);
  color:var(--text);
  padding:0 14px;
  outline:none;
}

.btn{
  min-height:40px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--panel2);
  color:var(--text);
  padding:8px 12px;
}

.btn:hover{border-color:var(--accent);color:var(--accent)}
.btn.primary{border-color:var(--accent);color:var(--accent)}
.btn.danger{border-color:var(--danger);color:var(--danger)}

.icon-btn{
  width:36px;height:36px;padding:0;
  display:grid;place-items:center;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--panel2);
  color:var(--text);
}

.footer-actions{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}

.empty{
  color:var(--muted);
  font-size:11px;
  text-align:center;
  padding:18px 8px;
}

dialog{
  width:min(720px,94vw);
  max-height:88dvh;
  border:1px solid var(--line);
  border-radius:20px;
  color:var(--text);
  background:var(--bg2);
  box-shadow:0 30px 100px rgba(0,0,0,.6);
  padding:0;
}

dialog::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(5px)}

.modal-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px;border-bottom:1px solid var(--line);
}

.modal-body{padding:16px;overflow:auto;max-height:72dvh}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.field{display:flex;flex-direction:column;gap:6px}
.field.full{grid-column:1/-1}
.field label{font-size:10px;color:var(--muted);letter-spacing:.12em;text-transform:uppercase}
.field input,.field select,.field textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--panel);
  color:var(--text);
  padding:10px;
  outline:none;
}
.field textarea{min-height:110px;resize:vertical}

.checkbox{
  display:flex;align-items:center;gap:8px;
  font-size:12px;
  color:var(--text);
}

.range-row{display:flex;align-items:center;gap:10px}
.range-row input{padding:0}

.toast{
  position:fixed;
  right:15px;
  top:78px;
  z-index:99;
  max-width:min(400px,90vw);
  padding:12px 15px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--panel);
  backdrop-filter:blur(18px);
  font-size:12px;
  transform:translateY(-20px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
}

.toast.show{transform:none;opacity:1}

@media(max-width:1050px){
  .workspace{grid-template-columns:220px minmax(0,1fr)}
  .side.right{display:none}
}

@media(max-width:720px){
  .workspace{
    display:block;
    padding:8px;
  }
  .side{display:none!important}
  .center{height:100%}
  .status{top:2%}
  .orb-wrap{width:min(75vw,430px)}
  .conversation{max-height:25%;bottom:1%}
  .composer{padding-left:8px;padding-right:8px}
  .composer .btn{padding:8px 10px}
  .brand small{display:none}
  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:auto}
}

@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{animation-duration:.01ms!important;transition:none!important}
}
</style>
</head>

<body>
<div class="app" id="app">

<header class="topbar">
  <div class="brand">
    <div class="logo">J</div>
    <div>
      <strong>J.A.R.V.I.S.</strong>
      <small>JUST A RATHER VERY INTELLIGENT SYSTEM</small>
    </div>
  </div>

  <div class="clock">
    <strong id="clock">--:--:--</strong>
    <small id="date">---</small>
  </div>

  <button class="icon-btn" id="settingsBtn" title="Configurações">⚙</button>
</header>

<main class="workspace">

  <aside class="side left">
    <section class="panel">
      <div class="panel-head">
        <span>Tarefas</span>
        <button class="icon-btn" id="addTaskBtn">+</button>
      </div>
      <div class="panel-body">
        <div id="tasks" class="list"></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <span>Notas</span>
        <button class="icon-btn" id="addNoteBtn">+</button>
      </div>
      <div class="panel-body">
        <div id="notes" class="list"></div>
      </div>
    </section>
  </aside>

  <section class="center">
    <div class="status">
      <div class="status-label" id="statusLabel">SISTEMA OCIOSO</div>
      <div class="status-detail" id="statusDetail">Pressione a barra de espaço ou o microfone</div>
    </div>

    <div class="orb-wrap">
      <canvas id="orb"></canvas>
      <div class="orb-ring"></div>
      <button class="mic-button" id="micBtn" aria-label="Falar">◉</button>
    </div>

    <div class="conversation" id="conversation"></div>
  </section>

  <aside class="side right">
    <section class="panel">
      <div class="panel-head">
        <span>Timers</span>
        <button class="icon-btn" id="addTimerBtn">+</button>
      </div>
      <div class="panel-body">
        <div id="timers" class="list"></div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <span>Sistema</span>
      </div>
      <div class="panel-body">
        <div class="item">
          <strong id="apiStatus">IA: não configurada</strong>
          <small id="micStatus">Microfone: aguardando</small>
        </div>
        <br>
        <div class="footer-actions">
          <button class="btn" id="themeBtn">Tema</button>
          <button class="btn" id="stopSpeechBtn">Parar fala</button>
          <button class="btn" id="clearChatBtn">Limpar conversa</button>
        </div>
      </div>
    </section>
  </aside>

</main>

<form class="composer" id="composer">
  <input id="textInput" autocomplete="off" placeholder="Digite um comando ou fale..." />
  <button class="btn primary" type="submit">Enviar</button>
</form>

</div>

<div class="toast" id="toast"></div>

<dialog id="settingsDialog">
  <div class="modal-head">
    <strong>Configurações do J.A.R.V.I.S.</strong>
    <button class="icon-btn" id="closeSettings">×</button>
  </div>

  <div class="modal-body">
    <div class="form-grid">

      <div class="field full">
        <label>Chave da API Anthropic</label>
        <input id="apiKey" type="password" placeholder="sk-ant-..." autocomplete="off">
      </div>

      <div class="field">
        <label>Modelo Claude</label>
        <select id="model">
          <option value="claude-sonnet-5">Claude Sonnet 5</option>
          <option value="claude-opus-5">Claude Opus 5</option>
          <option value="claude-fable-5">Claude Fable 5</option>
          <option value="claude-opus-4-8">Claude Opus 4.8</option>
          <option value="claude-sonnet-4-6">Claude Sonnet 4.6</option>
        </select>
      </div>

      <div class="field">
        <label>Palavra de ativação</label>
        <input id="wakeWord" value="jarvis">
      </div>

      <div class="field full">
        <label>
          <span class="checkbox">
            <input id="wakeEnabled" type="checkbox">
            Usar palavra de ativação
          </span>
        </label>
      </div>

      <div class="field full">
        <label>Voz</label>
        <select id="voiceSelect"></select>
      </div>

      <div class="field">
        <label>Tom</label>
        <div class="range-row">
          <input id="pitch" type="range" min=".5" max="1.5" step=".05" value=".82">
          <span id="pitchValue">0.82</span>
        </div>
      </div>

      <div class="field">
        <label>Velocidade</label>
        <div class="range-row">
          <input id="rate" type="range" min=".65" max="1.25" step=".05" value=".88">
          <span id="rateValue">0.88</span>
        </div>
      </div>

      <div class="field full">
        <label>Nome do senhor / senhora</label>
        <input id="userName" placeholder="Opcional">
      </div>

      <div class="field full">
        <label>Personalidade adicional</label>
        <textarea id="customPersonality" placeholder="Ex.: seja um pouco mais descontraído..."></textarea>
      </div>

      <div class="field full">
        <button class="btn primary" id="testVoiceBtn" type="button">Testar voz</button>
        <button class="btn" id="saveSettingsBtn" type="button">Salvar configurações</button>
      </div>

    </div>
  </div>
</dialog>

<script>
/* =========================================================
   J.A.R.V.I.S. — ASSISTENTE PESSOAL
   Tudo em um arquivo.
   ========================================================= */

/* =========================================================
   1. CONFIGURAÇÃO E ESTADO
   ========================================================= */

const STORAGE = {
  settings: "jarvis_settings_v1",
  memory: "jarvis_memory_v1",
  chat: "jarvis_chat_v1",
  tasks: "jarvis_tasks_v1",
  notes: "jarvis_notes_v1",
  timers: "jarvis_timers_v1"
};

const DEFAULTS = {
  apiKey: "",
  model: "claude-sonnet-5",
  wakeWord: "jarvis",
  wakeEnabled: false,
  voiceURI: "",
  pitch: .82,
  rate: .88,
  userName: "",
  customPersonality: "",
  theme: "dark"
};

let settings = load(STORAGE.settings, DEFAULTS);
settings = {...DEFAULTS, ...settings};

let memory = load(STORAGE.memory, {
  name: settings.userName || "",
  facts: [],
  preferences: []
});

let chat = load(STORAGE.chat, []);
let tasks = load(STORAGE.tasks, []);
let notes = load(STORAGE.notes, []);
let timers = load(STORAGE.timers, []);

let state = "idle";
let recognition = null;
let recognitionRunning = false;
let manualListening = false;
let wakeListening = false;
let speaking = false;
let currentSpeechId = 0;
let audioContext = null;
let analyser = null;
let micStream = null;
let volume = 0;
let assistantMessageEl = null;
let requestController = null;

/* =========================================================
   2. DOM
   ========================================================= */

const $ = id => document.getElementById(id);

const els = {
  app: $("app"),
  clock: $("clock"),
  date: $("date"),
  statusLabel: $("statusLabel"),
  statusDetail: $("statusDetail"),
  orb: $("orb"),
  micBtn: $("micBtn"),
  conversation: $("conversation"),
  textInput: $("textInput"),
  composer: $("composer"),
  toast: $("toast"),
  tasks: $("tasks"),
  notes: $("notes"),
  timers: $("timers"),
  apiStatus: $("apiStatus"),
  micStatus: $("micStatus"),
  settingsDialog: $("settingsDialog"),
  apiKey: $("apiKey"),
  model: $("model"),
  wakeWord: $("wakeWord"),
  wakeEnabled: $("wakeEnabled"),
  voiceSelect: $("voiceSelect"),
  pitch: $("pitch"),
  pitchValue: $("pitchValue"),
  rate: $("rate"),
  rateValue: $("rate"),
  userName: $("userName"),
  customPersonality: $("customPersonality")
};

/* =========================================================
   3. UTILITÁRIOS
   ========================================================= */

function load(key, fallback){
  try{
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  }catch{
    return fallback;
  }
}

function save(key, value){
  try{
    localStorage.setItem(key, JSON.stringify(value));
  }catch(e){
    toast("Não consegui salvar os dados neste navegador.");
  }
}

function uid(prefix="id"){
  return prefix + "_" + Date.now().toString(36) + Math.random().toString(36).slice(2,8);
}

function escapeText(value){
  return String(value ?? "");
}

function toast(message){
  els.toast.textContent = message;
  els.toast.classList.add("show");
  clearTimeout(toast.timer);
  toast.timer = setTimeout(() => els.toast.classList.remove("show"), 3500);
}

function setState(next, detail=""){
  state = next;
  const labels = {
    idle:"SISTEMA OCIOSO",
    listening:"OUVINDO",
    thinking:"PROCESSANDO",
    speaking:"FALANDO",
    error:"ERRO"
  };

  els.statusLabel.textContent = labels[next] || "SISTEMA";
  els.statusDetail.textContent = detail || ({
    idle:"Pressione a barra de espaço ou o microfone",
    listening:"Pode falar, senhor.",
    thinking:"Analisando sua solicitação.",
    speaking:"Transmitindo resposta.",
    error:"Verifique a mensagem abaixo."
  }[next] || "");

  els.micBtn.classList.toggle("active", next === "listening");
}

function nowISO(){
  return new Date().toISOString();
}

function formatDateTime(date){
  return new Intl.DateTimeFormat("pt-BR",{
    dateStyle:"short",
    timeStyle:"short"
  }).format(date);
}

function formatDuration(ms){
  const total = Math.max(0,Math.ceil(ms/1000));
  const h = Math.floor(total/3600);
  const m = Math.floor((total%3600)/60);
  const s = total%60;
  if(h) return `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
  return `${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
}

/* =========================================================
   4. RELÓGIO
   ========================================================= */

function updateClock(){
  const d = new Date();
  els.clock.textContent = d.toLocaleTimeString("pt-BR");
  els.date.textContent = d.toLocaleDateString("pt-BR",{
    weekday:"long",
    day:"2-digit",
    month:"long"
  });
}
setInterval(updateClock,1000);
updateClock();

/* =========================================================
   5. TEMA
   ========================================================= */

function applyTheme(){
  document.documentElement.dataset.theme = settings.theme;
  localStorage.setItem("jarvis_theme",settings.theme);
}

function toggleTheme(){
  settings.theme = settings.theme === "dark" ? "light" : "dark";
  applyTheme();
  save(STORAGE.settings,settings);
  speak("Tema alterado, senhor.",false);
}

applyTheme();

/* =========================================================
   6. ORBE HUD / VOLUME
   ========================================================= */

const ctx = els.orb.getContext("2d");
let orbTime = 0;

function resizeCanvas(){
  const rect = els.orb.getBoundingClientRect();
  const dpr = Math.min(devicePixelRatio || 1,2);
  els.orb.width = rect.width*dpr;
  els.orb.height = rect.height*dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0);
}
window.addEventListener("resize",resizeCanvas);
resizeCanvas();

function drawOrb(){
  const rect = els.orb.getBoundingClientRect();
  const w = rect.width;
  const h = rect.height;
  const cx = w/2;
  const cy = h/2;
  const r = Math.min(w,h)*.32;

  orbTime += .012;

  ctx.clearRect(0,0,w,h);

  const intensity = state === "listening" ? .8 :
                    state === "thinking" ? .55 :
                    state === "speaking" ? .75 : .3;

  const pulse = Math.sin(orbTime*2.4)*.025 + volume*.25;

  const glow = ctx.createRadialGradient(cx,cy,0,cx,cy,r*2.2);
  glow.addColorStop(0,"rgba(77,201,255,.25)");
  glow.addColorStop(.35,"rgba(77,201,255,.08)");
  glow.addColorStop(1,"rgba(77,201,255,0)");
  ctx.fillStyle = glow;
  ctx.fillRect(0,0,w,h);

  for(let ring=0;ring<5;ring++){
    const rr = r*(.55 + ring*.105 + pulse);
    ctx.beginPath();

    for(let i=0;i<=180;i++){
      const a = i/180*Math.PI*2;
      const noise =
        Math.sin(a*7 + orbTime*(1.3+ring*.1))*.018 +
        Math.sin(a*13 - orbTime*.8)*.012 +
        (state === "listening" ? Math.sin(a*23+orbTime*3)*volume*.035 : 0);

      const rad = rr*(1+noise);
      const x = cx+Math.cos(a)*rad;
      const y = cy+Math.sin(a)*rad;

      if(i===0) ctx.moveTo(x,y);
      else ctx.lineTo(x,y);
    }

    ctx.strokeStyle = `rgba(77,201,255,${.08 + intensity*.06})`;
    ctx.lineWidth = ring===0 ? 2 : 1;
    ctx.stroke();
  }

  const core = ctx.createRadialGradient(cx,cy,0,cx,cy,r*.65);
  core.addColorStop(0,"rgba(190,245,255,.9)");
  core.addColorStop(.08,"rgba(77,201,255,.75)");
  core.addColorStop(.35,"rgba(30,150,220,.22)");
  core.addColorStop(1,"rgba(0,80,130,0)");
  ctx.fillStyle = core;
  ctx.beginPath();
  ctx.arc(cx,cy,r*(.62+volume*.12),0,Math.PI*2);
  ctx.fill();

  for(let i=0;i<80;i++){
    const a = i/80*Math.PI*2 + orbTime*(.1 + (i%3)*.025);
    const rr = r*(.75 + ((i*17)%100)/100*.6);
    const x = cx+Math.cos(a)*rr;
    const y = cy+Math.sin(a)*rr;
    const size = 1 + ((i*13)%4)*.35;
    ctx.fillStyle = `rgba(130,225,255,${.15+intensity*.3})`;
    ctx.fillRect(x,y,size,size);
  }

  requestAnimationFrame(drawOrb);
}
drawOrb();

/* =========================================================
   7. SPEECH SYNTHESIS
   ========================================================= */

let voices = [];

function loadVoices(){
  voices = speechSynthesis.getVoices();

  const previous = settings.voiceURI;
  els.voiceSelect.textContent = "";

  const preferred = voices
    .filter(v => /^pt-BR$/i.test(v.lang))
    .sort((a,b) => {
      const score = v => {
        let s = 0;
        if(/male|homem|daniel|felipe|antonio|jorge/i.test(v.name)) s += 10;
        if(/google|microsoft/i.test(v.name)) s += 2;
        return s;
      };
      return score(b)-score(a);
    });

  const list = preferred.length ? preferred : voices;

  list.forEach(v => {
    const option = document.createElement("option");
    option.value = v.voiceURI;
    option.textContent = `${v.name} — ${v.lang}`;
    els.voiceSelect.appendChild(option);
  });

  if(previous && [...els.voiceSelect.options].some(o=>o.value===previous)){
    els.voiceSelect.value = previous;
  }else if(list[0]){
    els.voiceSelect.value = list[0].voiceURI;
    settings.voiceURI = list[0].voiceURI;
  }
}

speechSynthesis.onvoiceschanged = loadVoices;
loadVoices();

function speak(text, resumeListening=true){
  if(!text || !("speechSynthesis" in window)) return;

  currentSpeechId++;
  const speechId = currentSpeechId;

  stopListening(false);
  speechSynthesis.cancel();

  speaking = true;
  setState("speaking","Resposta sendo transmitida por voz.");

  const clean = String(text)
    .replace(/[*_`#>]/g,"")
    .replace(/\s+/g," ")
    .trim();

  if(!clean) return;

  const utter = new SpeechSynthesisUtterance(clean);
  utter.lang = "pt-BR";
  utter.pitch = Number(settings.pitch);
  utter.rate = Number(settings.rate);
  utter.volume = 1;

  const selected = voices.find(v=>v.voiceURI===settings.voiceURI);
  if(selected) utter.voice = selected;

  utter.onend = () => {
    if(speechId !== currentSpeechId) return;
    speaking = false;

    if(resumeListening && !settings.wakeEnabled){
      startListening(true);
    }else if(resumeListening && settings.wakeEnabled){
      startListening(false);
    }else{
      setState("idle");
    }
  };

  utter.onerror = () => {
    speaking = false;
    setState("error","A síntese de voz falhou. O texto continua disponível.");
  };

  speechSynthesis.speak(utter);
}

function speakSentences(text){
  const parts = String(text)
    .replace(/\n+/g," ")
    .match(/[^.!?]+[.!?]+|[^.!?]+$/g) || [];

  parts.map(x=>x.trim()).filter(Boolean).forEach((part,i)=>{
    setTimeout(()=>{
      speak(part,false);
    },i*100);
  });
}

function stopSpeech(){
  currentSpeechId++;
  speechSynthesis.cancel();
  speaking = false;
  setState("idle");
}

/* =========================================================
   8. MICROFONE / WEB SPEECH API
   ========================================================= */

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

function initRecognition(){
  if(!SpeechRecognition){
    els.micStatus.textContent = "Microfone: Web Speech API não disponível";
    toast("Seu navegador não oferece reconhecimento de voz. Use o campo de texto.");
    return false;
  }

  recognition = new SpeechRecognition();
  recognition.lang = "pt-BR";
  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.maxAlternatives = 1;

  recognition.onstart = () => {
    recognitionRunning = true;
    els.micStatus.textContent = "Microfone: ativo";
  };

  recognition.onresult = event => {
    let finalText = "";
    let interim = "";

    for(let i=event.resultIndex;i<event.results.length;i++){
      const result = event.results[i];
      const text = result[0].transcript;

      if(result.isFinal) finalText += text;
      else interim += text;
    }

    if(interim && state === "listening"){
      els.statusDetail.textContent = interim;
    }

    if(finalText.trim()){
      handleSpeechText(finalText.trim());
    }
  };

  recognition.onerror = event => {
    recognitionRunning = false;

    const messages = {
      "not-allowed":"Permissão do microfone negada.",
      "service-not-allowed":"O serviço de reconhecimento de voz foi bloqueado.",
      "audio-capture":"Nenhum microfone disponível.",
      "network":"Falha de rede no reconhecimento de voz.",
      "no-speech":"Nenhuma fala detectada.",
      "aborted":"Reconhecimento interrompido.",
      "language-not-supported":"Português do Brasil não está disponível."
    };

    const msg = messages[event.error] || `Erro real do microfone: ${event.error}`;
    els.micStatus.textContent = "Microfone: " + msg;
    els.statusDetail.textContent = msg;

    if(event.error === "not-allowed" || event.error === "service-not-allowed"){
      manualListening = false;
      wakeListening = false;
      setState("error",msg);
      toast(msg + " Use o campo de texto como fallback.");
    }
  };

  recognition.onend = () => {
    recognitionRunning = false;

    if(manualListening || wakeListening){
      setTimeout(()=>{
        try{
          recognition.start();
        }catch{}
      },250);
    }else{
      els.micStatus.textContent = "Microfone: aguardando";
    }
  };

  return true;
}

function startListening(manual=true){
  if(!recognition && !initRecognition()) return;

  if(speaking) stopSpeech();

  manualListening = manual;
  wakeListening = !manual;

  setState("listening",manual ? "Pode falar, senhor." : `Aguardando “${settings.wakeWord}”.`);

  try{
    recognition.start();
  }catch{}

  startMicMeter();
}

function stopListening(clearFlags=true){
  if(clearFlags){
    manualListening = false;
    wakeListening = false;
  }

  if(recognition){
    try{ recognition.stop(); }catch{}
  }

  recognitionRunning = false;
  stopMicMeter();

  if(clearFlags) setState("idle");
}

function handleSpeechText(text){
  const lower = text.toLocaleLowerCase("pt-BR");

  if(settings.wakeEnabled){
    if(!wakeListening && !lower.includes(settings.wakeWord.toLocaleLowerCase("pt-BR"))){
      return;
    }

    if(!manualListening){
      playWakeSound();

      const index = lower.indexOf(settings.wakeWord.toLocaleLowerCase("pt-BR"));
      const after = text.slice(index + settings.wakeWord.length).trim();

      if(!after){
        manualListening = true;
        setState("listening","Sim, senhor?");
        return;
      }

      text = after;
    }
  }

  stopListening();

  if(speaking) stopSpeech();

  sendUserMessage(text);
}

function playWakeSound(){
  try{
    const ac = audioContext || new AudioContext();
    audioContext = ac;
    const osc = ac.createOscillator();
    const gain = ac.createGain();
    osc.frequency.value = 880;
    gain.gain.value = .06;
    osc.connect(gain);
    gain.connect(ac.destination);
    osc.start();
    osc.stop(ac.currentTime+.08);
  }catch{}
}

/* =========================================================
   9. MEDIDOR DO MICROFONE
   ========================================================= */

async function startMicMeter(){
  if(!navigator.mediaDevices?.getUserMedia) return;

  try{
    micStream = await navigator.mediaDevices.getUserMedia({audio:true});
    audioContext = audioContext || new AudioContext();

    const source = audioContext.createMediaStreamSource(micStream);
    analyser = audioContext.createAnalyser();
    analyser.fftSize = 256;
    source.connect(analyser);

    const data = new Uint8Array(analyser.frequencyBinCount);

    function measure(){
      if(!analyser) return;
      analyser.getByteTimeDomainData(data);

      let sum=0;
      for(const n of data){
        const x=(n-128)/128;
        sum+=x*x;
      }

      volume=Math.min(1,Math.sqrt(sum/data.length)*3);
      if(recognitionRunning || manualListening || wakeListening){
        requestAnimationFrame(measure);
      }
    }

    measure();
  }catch{
    /* O reconhecimento pode funcionar mesmo se o medidor falhar. */
  }
}

function stopMicMeter(){
  volume=0;

  if(micStream){
    micStream.getTracks().forEach(t=>t.stop());
    micStream=null;
  }

  analyser=null;
}

