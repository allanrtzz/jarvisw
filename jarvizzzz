function renderConversation(){
  els.conversation.textContent = "";

  chat.slice(-30).forEach(msg=>{
    const div=document.createElement("div");
    div.className=`msg ${msg.role}`;

    const role=document.createElement("div");
    role.className="role";
    role.textContent=msg.role==="user" ? "Senhor" : "J.A.R.V.I.S.";

    const content=document.createElement("div");
    content.textContent=msg.content;

    div.append(role,content);
    els.conversation.appendChild(div);
  });

  els.conversation.scrollTop=els.conversation.scrollHeight;
}

function addMessage(role,content){
  chat.push({role,content,timestamp:nowISO()});
  chat=chat.slice(-40);
  save(STORAGE.chat,chat);
  renderConversation();
}

function startStreamingAssistant(){
  const div=document.createElement("div");
  div.className="msg assistant";

  const role=document.createElement("div");
  role.className="role";
  role.textContent="J.A.R.V.I.S.";

  const content=document.createElement("div");
  content.textContent="";

  div.append(role,content);
  els.conversation.appendChild(div);
  els.conversation.scrollTop=els.conversation.scrollHeight;

  return content;
}

