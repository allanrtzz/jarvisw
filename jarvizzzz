/* =========================================================
   15. API ANTHROPIC — STREAMING + TOOL USE
   ========================================================= */

async function sendToAnthropic(messages, onText){
  if(!settings.apiKey){
    throw new Error("A chave da API Anthropic não foi configurada.");
  }

  requestController?.abort();
  requestController=new AbortController();

  let workingMessages=messages.map(x=>({...x}));
  let finalText="";
  let rounds=0;

  while(rounds<8){
    rounds++;

    const response=await fetch("https://api.anthropic.com/v1/messages",{
      method:"POST",
      signal:requestController.signal,
      headers:{
        "Content-Type":"application/json",
        "x-api-key":settings.apiKey,
        "anthropic-version":"2023-06-01",
        "anthropic-dangerous-direct-browser-access":"true"
      },
      body:JSON.stringify({
        model:settings.model,
        max_tokens:700,
        system:systemPrompt(),
        tools:anthropicTools(),
        messages:workingMessages,
        stream:true
      })
    });

    if(!response.ok){
      let errorText="";
      try{
        const data=await response.json();
        errorText=data?.error?.message || "";
      }catch{}

      if(response.status===401){
        throw new Error("A chave da API Anthropic foi recusada.");
      }

      if(response.status===429){
        throw new Error("A Anthropic informou limite de requisições.");
      }

      throw new Error(errorText || `API Anthropic retornou HTTP ${response.status}.`);
    }

    if(!response.body){
      throw new Error("A API não retornou um fluxo de resposta.");
    }

    const reader=response.body.getReader();
    const decoder=new TextDecoder();
    let buffer="";
    let assistantBlocks=[];
    let currentBlock=null;
    let stopReason=null;

    while(true){
      const {value,done}=await reader.read();
      if(done) break;

      buffer+=decoder.decode(value,{stream:true});

      const chunks=buffer.split("\n\n");
      buffer=chunks.pop() || "";

      for(const chunk of chunks){
        const lines=chunk.split("\n");
        let event="";
        let data="";

        for(const line of lines){
          if(line.startsWith("event:")) event=line.slice(6).trim();
          if(line.startsWith("data:")) data+=line.slice(5).trim();
        }

        if(!data) continue;

        let payload;
        try{ payload=JSON.parse(data); }catch{ continue; }

        if(event==="content_block_start"){
          const block=payload.content_block;

          if(block?.type==="text"){
            currentBlock={
              type:"text",
              text:""
            };
            assistantBlocks[payload.index]=currentBlock;
          }else if(block?.type==="tool_use"){
            currentBlock={
              type:"tool_use",
              id:block.id,
              name:block.name,
              inputText:""
            };
            assistantBlocks[payload.index]=currentBlock;
          }
        }

        if(event==="content_block_delta"){
          const delta=payload.delta;
          const block=assistantBlocks[payload.index];

          if(!block) continue;

          if(delta?.type==="text_delta"){
            block.text+=delta.text;
            finalText+=delta.text;
            onText?.(delta.text);
          }

          if(delta?.type==="input_json_delta"){
            block.inputText+=delta.partial_json;
          }
        }

        if(event==="message_delta"){
          stopReason=payload.delta?.stop_reason || stopReason;
        }
      }
    }

    const normalizedBlocks=assistantBlocks.filter(Boolean).map(block=>{
      if(block.type==="text"){
        return {type:"text",text:block.text};
      }

      let input={};
      try{input=JSON.parse(block.inputText||"{}");}
      catch{input={};}

      return {
        type:"tool_use",
        id:block.id,
        name:block.name,
        input
      };
    });

    workingMessages.push({
      role:"assistant",
      content:normalizedBlocks
    });

    if(stopReason==="tool_use"){
      const results=[];

      for(const block of normalizedBlocks.filter(b=>b.type==="tool_use")){
        const tool=TOOLS[block.name];

        if(!tool){
          results.push({
            type:"tool_result",
            tool_use_id:block.id,
            is_error:true,
            content:"Ferramenta desconhecida."
          });
          continue;
        }

        try{
          const result=await tool.execute(block.input);

          results.push({
            type:"tool_result",
            tool_use_id:block.id,
            content:JSON.stringify(result)
          });
        }catch(error){
          results.push({
            type:"tool_result",
            tool_use_id:block.id,
            is_error:true,
            content:error?.message || "A ferramenta falhou."
          });
        }
      }

      workingMessages.push({
        role:"user",
        content:results
      });

      continue;
    }

    break;
  }

  return finalText.trim();
}

/* =========================================================
   16. ENVIO DE MENSAGEM
   ========================================================= */

async function sendUserMessage(text){
  text=String(text).trim();
  if(!text) return;

  if(speaking) stopSpeech();

  addMessage("user",text);
  setState("thinking","Consultando J.A.R.V.I.S.");

  assistantMessageEl=startStreamingAssistant();

  const contextMessages=chat.slice(-20).map(m=>({
    role:m.role,
    content:m.content
  }));

  try{
    els.apiStatus.textContent=settings.apiKey
      ? `IA: ${settings.model}`
      : "IA: não configurada";

    let accumulated="";

    const answer=await sendToAnthropic(contextMessages,delta=>{
      accumulated+=delta;
      assistantMessageEl.textContent=accumulated;
      els.conversation.scrollTop=els.conversation.scrollHeight;
    });

    const finalAnswer=answer || accumulated || "Não obtive uma resposta.";

    addMessage("assistant",finalAnswer);

    /* A resposta já foi transmitida no streaming.
       Aqui fazemos uma fala final natural.
       Se houver texto muito longo, dividimos em frases. */
    speakSentences(finalAnswer);

  }catch(error){
    const message=error?.name==="AbortError"
      ? "Solicitação interrompida."
      : (error?.message || "Não foi possível falar com a IA.");

    assistantMessageEl.textContent=message;
    addMessage("assistant",message);

    setState("error",message);
    toast(message);
  }
}

/* =========================================================
   17. TAREFAS / NOTAS / TIMERS
   ========================================================= */

function renderTasks(){
  els.tasks.textContent="";

  if(!tasks.length){
    els.tasks.innerHTML="";
    const e=document.createElement("div");
    e.className="empty";
    e.textContent="Nenhuma tarefa.";
    els.tasks.appendChild(e);
    return;
  }

  tasks.slice(0,30).forEach(t=>{
    const item=document.createElement("div");
    item.className="item";

    const strong=document.createElement("strong");
    strong.textContent=(t.done?"✓ ":"")+t.title;

    const small=document.createElement("small");
    small.textContent=t.due ? t.due : "Sem prazo";

    item.append(strong,small);
    els.tasks.appendChild(item);
  });
}

function renderNotes(){
  els.notes.textContent="";

  if(!notes.length){
    const e=document.createElement("div");
    e.className="empty";
    e.textContent="Nenhuma nota.";
    els.notes.appendChild(e);
    return;
  }

  notes.slice(0,20).forEach(n=>{
    const item=document.createElement("div");
    item.className="item";

    const strong=document.createElement("strong");
    strong.textContent=n.title;

    const small=document.createElement("small");
    small.textContent=n.content;

    item.append(strong,small);
    els.notes.appendChild(item);
  });
}

function renderTimers(){
  els.timers.textContent="";

  if(!timers.length){
    const e=document.createElement("div");
    e.className="empty";
    e.textContent="Nenhum timer ativo.";
    els.timers.appendChild(e);
    return;
  }

  timers.forEach(t=>{
    const item=document.createElement("div");
    item.className="item";

    const strong=document.createElement("strong");
    strong.textContent=t.label;

    const small=document.createElement("small");
    small.textContent=formatDuration(t.endAt-Date.now());

    item.append(strong,small);
    els.timers.appendChild(item);
  });
}

function timerLoop(){
  const now=Date.now();
  const finished=[];

  timers=timers.filter(t=>{
    if(t.endAt<=now){
      finished.push(t);
      return false;
    }
    return true;
  });

  if(finished.length){
    save(STORAGE.timers,timers);
    renderTimers();

    finished.forEach(t=>{
      playAlarm();
      toast(t.label);
      speak(`Senhor, ${t.label} terminou.`,false);
    });
  }else{
    renderTimers();
  }
}
setInterval(timerLoop,1000);

function playAlarm(){
  try{
    const ac=audioContext || new AudioContext();
    audioContext=ac;

    for(let i=0;i<4;i++){
      const osc=ac.createOscillator();
      const gain=ac.createGain();

      osc.type="sine";
      osc.frequency.value=i%2?660:880;

      gain.gain.setValueAtTime(.001,ac.currentTime+i*.28);
      gain.gain.exponentialRampToValueAtTime(.13,ac.currentTime+i*.28+.02);
      gain.gain.exponentialRampToValueAtTime(.001,ac.currentTime+i*.28+.22);

      osc.connect(gain);
      gain.connect(ac.destination);

      osc.start(ac.currentTime+i*.28);
      osc.stop(ac.currentTime+i*.28+.23);
    }
  }catch{}
}

renderTasks();
renderNotes();
renderTimers();

