  set_alarm:{
    description:"Cria um alarme para um horário local no formato HH:MM. A página precisa permanecer aberta.",
    input_schema:{
      type:"object",
      properties:{
        time:{type:"string",description:"HH:MM"},
        label:{type:"string"}
      },
