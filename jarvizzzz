function addMemoryFact(fact){
  fact=String(fact).trim();
  if(!fact) return;

  if(!memory.facts.includes(fact)){
    memory.facts.push(fact);
    memory.facts=memory.facts.slice(-50);
    save(STORAGE.memory,memory);
  }
}

function buildMemoryContext(){
  const parts=[];

  if(memory.name) parts.push(`Nome do usuário: ${memory.name}.`);
  if(memory.facts.length){
    parts.push("Fatos persistentes sobre o usuário: "+memory.facts.slice(-20).join(" | "));
  }
  if(memory.preferences.length){
    parts.push("Preferências: "+memory.preferences.slice(-20).join(" | "));
  }

  return parts.join("\n");
}

