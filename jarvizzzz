      const key={
        play:"MediaPlayPause",
        pause:"MediaPlayPause",
        next:"MediaTrackNext",
        previous:"MediaTrackPrevious"
      }[action];

      try{
        if("mediaSession" in navigator){
          navigator.mediaSession.playbackState=action==="pause"?"paused":"playing";
        }

        return {
          attempted:true,
          action,
          note:"O navegador não permite controlar arbitrariamente todos os players por JavaScript. A ação foi sinalizada ao sistema."
        };
      }catch(e){
        return {attempted:false,error:e.message};
      }
    }
  }

};

